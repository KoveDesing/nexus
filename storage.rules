rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isOwnerAdmin() { return signedIn() && request.auth.token.email == 'nexusadmin@gmail.com' && request.auth.token.email_verified == true; }
    function userRole() {
      return isOwnerAdmin() ? 'administrador' : firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }
    function canReadEvidence(uid, reportId) {
      return signedIn() && (request.auth.uid == uid || userRole() == 'administrador'
        || userRole() == 'tecnico'
          && firestore.get(/databases/(default)/documents/reports/$(reportId)).data.assignedTo == request.auth.uid);
    }

    match /profile-photos/{uid}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
    match /report-evidence/{uid}/{reportId}/{fileName} {
      allow read: if canReadEvidence(uid, reportId);
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
  }
}
