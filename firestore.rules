rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Las cuentas suspendidas pierden acceso a los datos de NEXUS aunque su sesión de Auth siga activa.
    function signedIn() {
      return request.auth != null &&
        (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('suspended', false) != true);
    }
    function myProfile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function admin() { return signedIn() && request.auth.token.email == 'nexusadmin@gmail.com'; }
    function role() { return admin() ? 'administrador' : (signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? myProfile().role : 'none'); }
    function staff() { return role() in ['tecnico', 'directivo', 'administrador']; }
    function owner(data) { return signedIn() && data.ownerUid == request.auth.uid; }

    match /users/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'estudiante'
        && request.resource.data.email == request.auth.token.email;
      allow read: if request.auth != null && (request.auth.uid == uid || admin() || staff());
      // El usuario solo cambia su nombre/color; no puede cambiar rol ni quitarse una suspensión.
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'accentColor']);
      // El administrador puede suspender cuentas, pero no cambiar roles desde el navegador.
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['displayName', 'accentColor', 'suspended']);
      allow delete: if admin();
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail == request.auth.token.email
        && request.resource.data.status == 'Nuevo'
        && request.resource.data.keys().hasAll(['title','category','location','description','priority','ownerUid','createdAt']);
      allow read: if signedIn() && (owner(resource.data) || admin()
        || role() == 'tecnico' && resource.data.assignedTo == request.auth.uid);
      // El dueño puede añadir mensajes, sin cambiar estado, asignación, prioridad o historial.
      allow update: if signedIn() && owner(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['messages','updatedAt','code','evidence'])
        && request.resource.data.messages.size() >= resource.data.messages.size()
        && request.resource.data.messages.size() <= resource.data.messages.size() + 1;
      // Personal autorizado puede actualizar el caso.
      allow update: if signedIn() && (admin() || role() == 'tecnico' && resource.data.assignedTo == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['status','priority','assignedTo','assignedName','assignedEmail','updatedAt','history','messages','evidence'])
        && request.resource.data.history.size() >= resource.data.history.size();
      allow delete: if admin();
    }
  }
}
